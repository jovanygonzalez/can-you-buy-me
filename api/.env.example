# =====================================================
# Can You Buy Me - Environment Variables (Example)
# =====================================================
# Copiar este archivo a .env y configurar según sea necesario

# =====================================================
# gRPC & HTTP Ports
# =====================================================
# Puerto gRPC puro (configurable). Default: 50051
GRPC_PORT=50051
# Puerto HTTP que sirve gRPC-Web + /health + webhooks (configurable). Default: 8070
HTTP_PORT=8070

# =====================================================
# PostgreSQL
# =====================================================
DB_HOST=localhost
DB_PORT=5435
DB_USER=root
DB_PASSWORD=root
DB_NAME=auction_db
DB_SSL_MODE=disable

# =====================================================
# Redis
# =====================================================
REDIS_URL=redis://localhost:6379/0

# =====================================================
# NATS JetStream
# =====================================================
NATS_URL=nats://localhost:4222
# WebSocket para Flutter Web (los navegadores no hacen TCP crudo).
# El cliente Dart de NATS se conecta aquí; el backend Go usa NATS_URL.
NATS_WS_URL=ws://localhost:8443

# =====================================================
# Stripe Payment Integration
# =====================================================
# API Key (Secret) - https://dashboard.stripe.com/apikeys
# Formato: sk_test_... (development) o sk_live_... (production)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# Publishable Key - para el frontend (opcional en MVP)
# Formato: pk_test_... (development) o pk_live_... (production)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook Secret - para validar webhooks
# Desarrollo local: obtener con `stripe listen --forward-to localhost:8070/webhooks/stripe`
# El comando imprime el whsec_test_... que debes pegar aquí
# Formato: whsec_test_... (development) o whsec_live_... (production)
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# =====================================================
# JWT Secret (para tokens JWT futuros)
# =====================================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# =====================================================
# AWS S3 (para imágenes)
# =====================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
S3_BUCKET=can-you-buy-me

# =====================================================
# Configuración General
# =====================================================
ENVIRONMENT=development
LOG_LEVEL=info
