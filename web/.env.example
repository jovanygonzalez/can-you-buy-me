# URL del backend gRPC-Web (Go, StartHTTPServer en :8070).
# Prefijo PUBLIC_ obligatorio para que Astro la exponga al cliente.
PUBLIC_GRPC_BASE_URL=http://localhost:8070

# Google OAuth 2.0 Client ID (tipo "Web application" en Google Cloud Console).
# Debe ser el MISMO Client ID que GOOGLE_CLIENT_ID en api/.env.
# Authorized JavaScript origins debe incluir http://localhost:4321 (dev).
PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
